#--------------------------------------------------------------
# Example Terraform Variables File
# Copy this file to terraform.tfvars and update the values
#--------------------------------------------------------------

# Core Settings
workload_name = "inte"
environment   = "dev"
location      = "australiaeast"

# Subscription IDs - REQUIRED: Update these with your subscription IDs
hub_subscription_id                  = "c8703ebc-bc5d-488d-9489-5883c9fde6c2"
spoke_subscription_id                = "c8703ebc-bc5d-488d-9489-5883c9fde6c2"
application_insights_subscription_id = "c8703ebc-bc5d-488d-9489-5883c9fde6c2"

# Feature Flags
deploy_sample         = true
deploy_apim           = true
deploy_api_center     = true
deploy_app_gateway    = true
deploy_azure_firewall = true
deploy_bastion        = true
deploy_key_vault      = true

# Use existing network resources (set to true if VNet already exists)
use_existing_virtual_network         = false
use_existing_virtual_network_subnets = false

# Network Settings
hub_vnet_address_prefixes = ["10.132.0.0/24", "10.132.13.0/24"]
firewall_private_ip       = "10.132.0.4"

# APIM Settings
apim_publisher_email      = "apim@contoso.com"
apim_publisher_name       = "Contoso"
apim_sku_name             = "StandardV2"
apim_capacity             = 1
apim_virtual_network_type = "External"
apim_availability_zones   = ["1", "2", "3"]

# Existing Resources - Update these with your existing Log Analytics and App Insights details
log_analytics_workspace_name           = "LA-AE-MGMT-01"
log_analytics_workspace_resource_group = "rg-ae-mgmt-oms-01"
sentinel_workspace_name                = "NDA-COR-AWG-SENTINEL-PROD"
sentinel_workspace_resource_group      = "nda-cor-arg-sentinel-prod"
application_insights_name              = "appi-ae-mgmt-01"
application_insights_resource_group    = "rg-ae-mgmt-oms-01"

# Tags
tags = {
  Project     = "APIM-Landing-Zone"
  Environment = "dev"
  ManagedBy   = "Terraform"
}
